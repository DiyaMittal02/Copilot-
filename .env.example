# Copy this file to .env.local and fill in ONE provider.
#
# Choose the LLM provider (default: gemini):
LLM_PROVIDER=gemini
# Optional model override (otherwise a sensible default per provider is used):
# LLM_MODEL=gemini-2.0-flash

# --- Provide the key for whichever provider you chose above ---

# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (free): https://console.groq.com/keys
# GROQ_API_KEY=

# OpenAI (paid): https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Ollama (local, no key needed): run `ollama serve` and set LLM_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434/v1
